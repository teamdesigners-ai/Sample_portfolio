<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Oodagaa – Your next-door social media mate</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600&family=Montserrat:wght@500;700;800&family=Noto+Sans+Tamil:wght@700&display=swap" rel="stylesheet">
<style>
:root{--bg:#eef0f1;--ink:#0d1b24;--mute:#52606a;--blue:#37aee2;--sky:#c5e5f4;--card:#f7f8f8;--line:#0d1b24;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0c161d;--ink:#eaf1f5;--mute:#93a4af;--sky:#123446;--card:#13222c;--line:#eaf1f5}}
:root[data-theme="dark"]{--bg:#0c161d;--ink:#eaf1f5;--mute:#93a4af;--sky:#123446;--card:#13222c;--line:#eaf1f5}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
body{background:var(--bg);color:var(--ink);font:400 17px/1.6 Jost,system-ui,sans-serif;overflow-x:hidden}
h1,h2,h3{font-family:Montserrat,sans-serif;line-height:1.05}
a{color:inherit}
:focus-visible{outline:3px solid var(--blue);outline-offset:3px}
nav{position:fixed;top:env(safe-area-inset-top,0px);left:0;right:0;z-index:20;display:flex;justify-content:space-between;align-items:center;padding:14px 5vw;background:color-mix(in srgb,var(--bg) 85%,transparent);backdrop-filter:blur(10px);border-bottom:2px solid var(--line)}
.logo{font:800 15px Montserrat;letter-spacing:.35em;text-decoration:none}
nav div{display:flex;gap:22px;align-items:center}
nav a:not(.logo){font-weight:500;text-decoration:none;font-size:15px}
nav a:not(.logo):hover{color:var(--blue)}
#tg{background:none;border:2px solid var(--line);color:var(--ink);border-radius:50%;width:34px;height:34px;cursor:pointer;font-size:15px}
@media(max-width:760px){nav div a:not(.cta){display:none}}
.cta{background:var(--ink);color:var(--bg)!important;padding:8px 18px;border-radius:99px}
section{padding:110px 5vw 40px;max-width:1280px;margin:auto}
.hero{min-height:100svh;display:flex;flex-direction:column;justify-content:center;position:relative;max-width:none;overflow:hidden}
.blob{position:absolute;right:-12vw;top:50%;width:min(70vw,780px);aspect-ratio:1;border-radius:50%;background:var(--sky);transform:translate(var(--mx,0),calc(-50% + var(--my,0)));transition:transform .4s ease-out}
.hint{margin-top:34px;font-size:14px;color:var(--mute)}
h2{font-size:clamp(32px,5vw,60px);font-weight:800;margin-bottom:28px}
h2 span{color:var(--blue)}
.lede{max-width:62ch;font-size:20px}
.lede+.lede{margin-top:16px;color:var(--mute)}
.svc{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:20px}
.svc button{text-align:left;font:inherit;color:inherit;background:var(--card);border:2px solid var(--line);box-shadow:6px 6px 0 var(--line);padding:24px;cursor:pointer;transition:transform .2s,box-shadow .2s}
.svc button:hover{transform:translate(-2px,-2px);box-shadow:9px 9px 0 var(--blue)}
.svc h3{font-size:21px}
.svc ul{list-style:none;padding:0;max-height:0;overflow:hidden;transition:max-height .35s ease}
.svc button[aria-expanded=true] ul{max-height:220px}
.svc li{padding-top:7px;color:var(--mute)}
.svc li:first-child{padding-top:14px}
.svc small{display:block;color:var(--blue);font-weight:600;margin-top:8px}
.mq{overflow:hidden;margin:0 -5vw;border-block:2px solid var(--line);padding:16px 0;background:var(--card)}
.mq div{display:flex;gap:46px;width:max-content;animation:mq 40s linear infinite;font:700 24px Montserrat;white-space:nowrap}
.mq:hover div{animation-play-state:paused}
.mq span:nth-child(even){color:var(--blue)}
@keyframes mq{to{transform:translateX(-50%)}}
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:40px 44px;margin-top:34px}.stat{min-width:0}
.stat{border:2px solid var(--line);box-shadow:6px 6px 0 var(--line);padding:22px;background:var(--card)}
.stat b{font:800 clamp(44px,5.4vw,72px)/1 Montserrat;display:block;white-space:nowrap;margin-bottom:10px}
.stat b i{color:var(--blue);font-style:normal}
.stat span{color:var(--mute);font-weight:500}
.tabs{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:22px}
.tabs button{font:600 15px Jost;border:2px solid var(--line);background:none;color:var(--ink);padding:8px 18px;border-radius:99px;cursor:pointer}
.tabs button[aria-pressed=true],.tabs button[aria-selected=true]{background:var(--ink);color:var(--bg)}
.case{display:grid;grid-template-columns:1fr 1fr;gap:26px;border:2px solid var(--line);box-shadow:6px 6px 0 var(--line);padding:clamp(20px,3vw,40px);background:var(--card)}
@media(max-width:800px){.case{grid-template-columns:1fr}}
.case h3{font-size:14px;letter-spacing:.1em;margin:0 0 6px;color:var(--blue)}
.case p,.case li{color:var(--mute)}
.case ul{padding-left:20px}
.case .big{grid-column:1/-1;font:700 clamp(20px,2.6vw,30px)/1.3 Montserrat;color:var(--ink)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:18px}
.tile{aspect-ratio:4/5;border:2px solid var(--line);box-shadow:5px 5px 0 var(--line);padding:16px;display:flex;flex-direction:column;justify-content:flex-end;text-decoration:none;color:#fff;position:relative;overflow:hidden;transition:transform .25s,box-shadow .25s}
a.tile:hover{transform:translateY(-6px) rotate(-1deg);box-shadow:5px 11px 0 var(--blue)}
.tile::before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 80% 15%,rgba(255,255,255,.35),transparent 55%)}
.tile b{font:700 19px/1.15 Montserrat;position:relative;text-shadow:0 2px 12px rgba(0,0,0,.45)}
.tile small{position:relative;font-weight:600;opacity:.9;margin-top:6px}
.tile.fresh{animation:in .4s ease both}
@keyframes in{from{opacity:0;transform:scale(.94)}}
.end{text-align:center;padding-bottom:90px}
.end p{font:700 clamp(22px,3.4vw,40px)/1.25 Montserrat;max-width:24ch;margin:0 auto 26px}
.end .cta{display:inline-block;text-decoration:none;font-weight:600;font-size:20px;padding:14px 30px;margin:6px}
.end .cta.alt{background:none;color:var(--ink)!important;border:2px solid var(--line)}
footer{padding:22px 5vw;border-top:2px solid var(--line);color:var(--mute);font-size:14px;text-align:center}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}

.logo img{height:36px;display:block}
.hero>*:not(.blob){position:relative}
.hero h1{font-size:clamp(46px,11vw,170px);font-weight:800;letter-spacing:.14em}
.hero p{font-size:clamp(20px,2.4vw,30px);max-width:20ch;margin-top:18px}
.hero p b{background:linear-gradient(transparent 62%,var(--blue) 62%)}

@keyframes pop{from{opacity:0;transform:scale(.4) rotate(-14deg)}}
@keyframes fl{50%{transform:translateY(-14px) rotate(1.5deg)}}
#pgb{position:fixed;top:0;left:0;width:100%;height:4px;background:var(--blue);transform-origin:0 50%;transform:scaleX(var(--p,0));z-index:40}
#cur{position:fixed;left:0;top:0;width:16px;height:16px;border-radius:50%;background:var(--blue);mix-blend-mode:multiply;pointer-events:none;z-index:50;opacity:0;transition:width .25s,height .25s,opacity .3s;margin:-8px 0 0 -8px}
#cur.big{width:56px;height:56px;margin:-28px 0 0 -28px}
@media(hover:none){#cur{display:none}}
.js .rv{opacity:0}
.js .rv.in{opacity:1;animation:rvin .85s cubic-bezier(.2,.8,.2,1) backwards;animation-delay:var(--d,0ms)}
@keyframes rvin{from{opacity:0;transform:translateY(46px) scale(.97)}}
h2{position:relative;display:inline-block}
h2::after{content:"";position:absolute;left:0;bottom:-8px;height:5px;width:100%;background:var(--blue);transform:scaleX(0);transform-origin:0 50%;transition:transform .9s .3s cubic-bezier(.2,.8,.2,1)}
h2.in::after{transform:none}
section>h2{display:block;width:fit-content}
.mq{border:0;background:none;padding:10px 0;margin-bottom:6px}
.mq div{gap:26px}
.mq img{height:min(52vw,320px);width:auto;display:block;border-radius:2px}
.rev div{animation-direction:reverse}
.grid{display:block;columns:210px;column-gap:18px}
.grid .tile{aspect-ratio:auto;padding:0;display:block;break-inside:avoid;margin:0 0 18px;background:#000;box-shadow:5px 5px 0 var(--line);transform:perspective(700px) rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .18s ease-out,box-shadow .25s}
.grid .tile::before{display:none}
.grid .tile:hover{box-shadow:5px 5px 0 var(--blue);z-index:2}
.tile button{all:unset;display:block;cursor:pointer;position:relative;width:100%}
.tile img{display:block;width:100%;height:auto;transition:transform .6s}
.tile:hover img{transform:scale(1.06)}
.tile button::after{content:"";position:absolute;inset:0;background:radial-gradient(circle at var(--sx,50%) var(--sy,50%),rgba(255,255,255,.28),transparent 55%);opacity:0;transition:opacity .25s}
.tile:hover button::after{opacity:1}
.tile figcaption{position:absolute;left:0;right:0;bottom:0;padding:34px 12px 10px;background:linear-gradient(transparent,rgba(0,0,0,.78));color:#fff;font:700 15px/1.2 Montserrat;transform:translateY(60%);opacity:0;transition:.3s}
.tile:hover figcaption,.tile button:focus-visible figcaption{transform:none;opacity:1}
.tile small{display:block;font:500 12px Jost;opacity:.85;margin-top:3px}
#lb{border:2px solid var(--line);background:var(--card);color:var(--ink);padding:0;max-width:min(92vw,520px);max-height:92vh;margin:auto;overflow:auto;box-shadow:10px 10px 0 var(--blue)}
#lb[open]{animation:pop .4s cubic-bezier(.2,.9,.2,1)}
#lb::backdrop{background:rgba(5,15,22,.72);backdrop-filter:blur(6px)}
#lbi{display:block;width:100%;max-height:68vh;object-fit:contain;background:#000}
.lbf{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 16px;flex-wrap:wrap;font-weight:600}
.lbf span:last-child{display:flex;gap:8px;align-items:center}
.lbf .cta{font-size:14px;text-decoration:none;padding:7px 14px}
.lbf button{font:600 18px Jost;border:2px solid var(--line);background:none;color:var(--ink);width:34px;height:34px;border-radius:50%;cursor:pointer}
.end .panel{background:var(--blue);color:#04222f;border:2px solid var(--line);box-shadow:8px 8px 0 var(--line);padding:clamp(30px,6vw,80px) 5vw;overflow:hidden}
.end h2{display:block;margin-inline:auto}.end h2::after{display:none}
.end h2 span{color:#fff}
.end .panel .cta{background:#04222f;color:#fff!important}
.end .panel .cta.alt{background:none;color:#04222f!important;border-color:#04222f}
#wl{width:min(320px,62vw);display:block;margin:0 auto 22px;animation:fl 6s ease-in-out infinite}
@media(prefers-reduced-motion:reduce){.w span{transform:none}.js .rv{opacity:1}}

.wk{display:flex;flex-direction:column;gap:60px}
.ch{display:flex;align-items:baseline;gap:14px;border-bottom:2px solid var(--line);padding-bottom:10px;margin-bottom:24px}
.ch h3{font-size:clamp(20px,2.4vw,28px)}
.ch span{margin-left:auto;color:var(--mute);font-weight:500;font-size:15px}
.cat .grid{display:grid;columns:auto;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:28px 22px}
.cat .grid .tile{margin:0;background:var(--card);display:flex;flex-direction:column;break-inside:auto}
.tile .im{display:block;aspect-ratio:4/5;overflow:hidden;position:relative;background:#000}
.tile .im img{width:100%;height:100%;object-fit:cover}
.tile .im img.ls{object-fit:contain}
.cat .tile figcaption{position:static;transform:none;opacity:1;background:none;color:var(--ink);padding:10px 12px 12px;font:700 15px/1.25 Montserrat;display:block;border-top:2px solid var(--line);text-align:left}
.cat .tile small{color:var(--mute);font-weight:500}

.cat .grid .tile{display:flex}
.cat .tile button{flex:1;display:flex;width:auto}
.tile .im{flex:1;aspect-ratio:4/5;min-height:0;display:block}
.tile.wide{grid-column:span 2}
.tile.wide .im{aspect-ratio:8/5}
.tile .im img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
@media(max-width:560px){.cat .grid{grid-template-columns:repeat(2,1fr);gap:18px 14px}}
.cs-sw{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:30px}
.cs-sw button{font:700 17px Montserrat;border:2px solid var(--line);background:var(--card);color:var(--ink);padding:14px 26px;cursor:pointer;box-shadow:5px 5px 0 var(--line);transition:transform .2s,box-shadow .2s,background .2s}
.cs-sw button:hover{background:var(--sky)}
.cs-sw button[aria-selected=true]{background:var(--blue);color:#04222f;transform:translate(3px,3px);box-shadow:2px 2px 0 var(--line)}
.cs-body{display:grid;grid-template-columns:240px 1fr;gap:40px;align-items:start}
.steps{display:flex;flex-direction:column;position:relative}
.steps button{all:unset;cursor:pointer;display:flex;align-items:center;gap:14px;padding:14px 0;font:700 18px Montserrat;color:var(--mute);position:relative;transition:color .25s}
.steps button b{width:38px;height:38px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;font-size:15px;background:var(--bg);position:relative;z-index:1;transition:.3s}
.steps button:not(:last-child)::after{content:"";position:absolute;left:18px;top:52px;height:calc(100% - 38px);width:2px;background:var(--line);opacity:.25}
.steps button.done::after{background:var(--blue);opacity:1}
.steps button.done b{background:var(--blue);border-color:var(--blue);color:#04222f}
.steps button.on{color:var(--ink)}
.steps button.on b{background:var(--ink);color:var(--bg);transform:scale(1.15)}
.steps button:hover{color:var(--blue)}
.steps button:focus-visible{outline:3px solid var(--blue);outline-offset:4px}
@media(max-width:800px){.cs-body{grid-template-columns:1fr;gap:22px}.steps{flex-direction:row;overflow-x:auto;gap:18px}.steps button{font-size:15px;white-space:nowrap}.steps button::after{display:none!important}}
.stage{border:2px solid var(--line);box-shadow:6px 6px 0 var(--line);background:var(--card);padding:clamp(22px,3vw,40px);min-height:380px;display:flex;flex-direction:column;justify-content:space-between;gap:26px}
.sc{animation:scin .55s cubic-bezier(.2,.8,.2,1)}
@keyframes scin{from{opacity:0;transform:translateX(34px)}}
.sc h3{font-size:14px;letter-spacing:.1em;color:var(--blue);margin-bottom:16px}
.big2{font:700 clamp(21px,2.8vw,32px)/1.3 Montserrat;max-width:30ch}
.big2.res{border-left:6px solid var(--blue);padding-left:20px;max-width:34ch}
.chip{display:inline-block;border:2px solid var(--line);padding:10px 18px;margin:0 12px 14px 0;font-weight:600;font-size:18px;animation:chp .55s cubic-bezier(.2,.9,.2,1.3) backwards;animation-delay:calc(var(--i)*100ms);transition:background .2s,transform .2s;cursor:default}
.chip:hover{background:var(--blue);color:#04222f;transform:translateY(-4px) rotate(-1.5deg)}
@keyframes chp{from{opacity:0;transform:scale(.5) translateY(18px)}}
.imp{list-style:none;padding:0;margin-bottom:22px}
.imp li{padding:6px 0 6px 26px;position:relative;color:var(--mute);animation:rvin .6s cubic-bezier(.2,.8,.2,1) backwards;animation-delay:var(--d)}
.imp li::before{content:"";position:absolute;left:0;top:15px;width:11px;height:11px;border-radius:50%;background:var(--blue)}
.bl{display:flex;justify-content:space-between;font-weight:600;margin-top:12px}
.bl b{color:var(--blue)}
.bar{height:18px;background:color-mix(in srgb,var(--line) 12%,transparent);position:relative;margin:6px 0 4px;overflow:hidden}
.bar::before{content:"";position:absolute;left:0;top:0;bottom:0;width:var(--a);background:var(--sky)}
.bar i{position:absolute;left:var(--a);top:0;bottom:0;width:0;background:var(--blue);transition:width 1.5s cubic-bezier(.2,.8,.2,1)}
.bar.go i{width:var(--w)}
.ctl{display:flex;align-items:center;gap:16px}
.ctl button{font:600 16px Jost;border:2px solid var(--line);background:none;color:var(--ink);padding:9px 20px;border-radius:99px;cursor:pointer;transition:.2s}
.ctl button:hover:not(:disabled){background:var(--ink);color:var(--bg)}
.ctl button:disabled{opacity:.35;cursor:default}
.pr{flex:1;height:6px;background:color-mix(in srgb,var(--line) 15%,transparent)}
.pr i{display:block;height:100%;background:var(--blue);transition:width .5s cubic-bezier(.2,.8,.2,1)}

.cat .grid{display:flex;flex-wrap:wrap;gap:22px;--H:230px}
.cat .grid::after{content:"";flex-grow:1000000}
.cat .grid .tile{flex:var(--ar) 1 calc(var(--ar)*var(--H));min-width:0}
.tile .im{flex:none;width:100%;aspect-ratio:var(--ar)}
@media(max-width:560px){.cat .grid{gap:14px;--H:150px}}

.arc{padding-bottom:110px}
.arc .lede{margin:-8px 0 30px;color:var(--mute)}
.win{max-width:940px;border:2px solid var(--line);box-shadow:8px 8px 0 var(--line);background:var(--card)}
.tb2{display:flex;align-items:flex-end;gap:18px;padding:12px 14px 0;background:color-mix(in srgb,var(--line) 12%,var(--bg));border-bottom:2px solid var(--line)}
.dots{display:flex;gap:6px;align-self:center;padding-bottom:10px}
.dots u{width:12px;height:12px;border:2px solid var(--line);display:block}
.tab{display:flex;align-items:center;gap:10px;min-width:min(240px,60%);padding:10px 14px;background:var(--card);border:2px solid var(--line);border-bottom:0;margin-bottom:-2px;font:600 15px Jost}
.tab img{width:20px;height:20px;object-fit:contain}
.tab i{margin-left:auto;font-style:normal;opacity:.55}
.addr{display:flex;gap:16px;align-items:center;padding:10px 14px;border-bottom:2px solid var(--line);font:500 15px Jost}
.addr>span{letter-spacing:.25em;color:var(--mute)}
.url{flex:1;min-width:0;border:2px solid var(--line);padding:6px 14px;background:var(--bg);color:var(--mute);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
#dino{display:block;width:100%;aspect-ratio:10/3;background:var(--card);cursor:pointer;touch-action:manipulation;transition:filter 1s}
#dino.inv{filter:invert(1) hue-rotate(180deg)}
.cap{display:flex;justify-content:space-between;align-items:baseline;gap:6px 24px;flex-wrap:wrap;padding:14px 18px;border-top:2px solid var(--line);font-weight:500;color:var(--mute)}
.cap b{font:700 16px Montserrat;color:var(--ink)}

.end .panel{position:relative;padding:clamp(24px,4vw,46px) 5vw}
#ta{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}
.pin{position:relative;z-index:1}
#wl{width:min(180px,46vw);margin-bottom:10px}
.end h2{font-size:clamp(26px,3.4vw,40px);margin-bottom:12px}
.end p{font:500 clamp(16px,1.5vw,19px)/1.55 Jost;max-width:44ch;margin:0 auto 22px}
.acts{display:flex;flex-wrap:wrap;gap:10px;justify-content:center}
.end .acts .cta{margin:0;font:600 16px Jost;padding:10px 20px;border:2px solid #04222f;cursor:pointer;transition:transform .2s ease-out,background .2s}
.end .acts .cta.alt:hover{background:#04222f;color:#fff!important}
.tip{display:block;margin-top:16px;color:#04222f;opacity:.7;font-size:14px}
.cbl{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:60;display:flex;align-items:center;gap:10px;padding:10px 16px;background:var(--blue);color:#04222f;border:2px solid var(--line);box-shadow:4px 4px 0 var(--line);font:700 16px Montserrat;cursor:pointer;transition:transform .2s,box-shadow .2s}
.cbl:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--line)}
.cbl img{width:26px;height:26px;object-fit:contain}
.cbl::after{content:"";position:absolute;inset:-2px;border:2px solid var(--blue);animation:ring2 2.6s ease-out infinite;pointer-events:none}
@keyframes ring2{to{transform:scale(1.35);opacity:0}}
.cw{position:fixed;right:18px;bottom:calc(78px + env(safe-area-inset-bottom,0px));z-index:61;width:min(370px,calc(100vw - 36px));height:min(540px,calc(100svh - 120px));display:flex;flex-direction:column;background:var(--card);border:2px solid var(--line);box-shadow:8px 8px 0 var(--line);transform-origin:100% 100%}
.cw[hidden]{display:none}
.cw.open{animation:cwin .35s cubic-bezier(.2,.9,.2,1)}
@keyframes cwin{from{opacity:0;transform:scale(.7) translateY(30px)}}
.cw header{display:flex;align-items:center;gap:12px;padding:12px 14px;background:var(--blue);color:#04222f;border-bottom:2px solid var(--line)}
.cw header img{width:34px;height:34px;object-fit:contain;background:#fff;padding:3px;border-radius:50%}
.cw header div{flex:1;line-height:1.2}.cw header b{font:800 17px Montserrat;display:block}
.cw header small{display:flex;align-items:center;gap:6px;font-weight:500}
